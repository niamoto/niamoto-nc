# Path absolu du site statique généré par Niamoto (mode export).
# Le container monte ce dossier en read-only sur /usr/share/nginx/html.
NIAMOTO_WWW_PATH=/home/niamoto/nginx-www

# Réseau Docker partagé avec Traefik (créé en externe par la stack Traefik).
TRAEFIK_NETWORK=traefik

# Entrypoint Traefik à utiliser (typiquement `websecure` pour HTTPS).
TRAEFIK_ENTRYPOINT=websecure

# Nom du certresolver ACME défini côté Traefik.
TRAEFIK_CERTRESOLVER=letsencrypt
